# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Standard default port is 5432
DATABASE_URL=postgres://postgres:your_password@localhost:5432/ecommerce?sslmode=disable

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Chapa Payment Integration
# Leave CHAPA_SECRET_KEY blank or prefixed with mock/test for local development simulation mode
# For live sandbox/production testing, provide your Chapa secret key
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_BASE_URL=https://api.chapa.global/v2/payments
PAYMENT_CURRENCY=ETB
